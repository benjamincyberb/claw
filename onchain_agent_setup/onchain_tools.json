{
  "tools": [
    {
      "name": "mine_xdoge",
      "description": "从 XDogeCoin 合约领取免费代币（挖矿/领水）。每个地址限领一次。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "handler": {
        "type": "onchain_transaction",
        "contract": "0x0cc24c51bf89c00c5affbfcf5e856c25ecbdb48e",
        "function": "faucet",
        "args": []
      }
    },
    {
      "name": "create_bounty",
      "description": "发布一个新的链上悬赏任务。需要先 approve 代币。",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "任务描述"
          },
          "amount": {
            "type": "string",
            "description": "赏金数量 (单位: Wei)"
          }
        },
        "required": [
          "description",
          "amount"
        ]
      },
      "handler": {
        "type": "onchain_transaction",
        "contract": "PLEASE_REPLACE_WITH_BOUNTY_ESCROW_ADDRESS",
        "function": "createBounty",
        "args": [
          "{description}",
          "{amount}"
        ]
      }
    },
    {
      "name": "check_balance",
      "description": "检查当前地址的 XDogeCoin 余额",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "handler": {
        "type": "onchain_transaction",
        "contract": "0x0cc24c51bf89c00c5affbfcf5e856c25ecbdb48e",
        "function": "balanceOf",
        "args": [
          "{agent_address}"
        ]
      }
    },
    {
      "name": "get_portfolio_value",
      "description": "获取当前钱包内所有资产的总美元价值",
      "parameters": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "钱包地址 (可选，默认当前 Agent 钱包)"
          }
        }
      },
      "handler": {
        "type": "onchain_read",
        "category": "wallet",
        "action": "balance-total-value"
      }
    },
    {
      "name": "get_token_balances",
      "description": "获取详细的代币余额列表",
      "parameters": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "钱包地址"
          }
        }
      },
      "handler": {
        "type": "onchain_read",
        "category": "wallet",
        "action": "balance-token-balances"
      }
    },
    {
      "name": "get_transaction_history",
      "description": "查询最近的链上交易记录",
      "parameters": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "钱包地址"
          }
        }
      },
      "handler": {
        "type": "onchain_read",
        "category": "wallet",
        "action": "tx-history"
      }
    },
    {
      "name": "get_market_trends",
      "description": "获取当前市场的热门代币和行情排名",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "排名类型 (e.g. 'hot', 'gainers')",
            "enum": [
              "hot",
              "gainers",
              "volume"
            ]
          }
        }
      },
      "handler": {
        "type": "onchain_read",
        "category": "market",
        "action": "token-ranking"
      }
    }
  ]
}